# ==============================================================================
# zagent Model & Provider Configuration
# ==============================================================================
# Secrets and provider settings live here; runtime and tool configurations
# live in config.json. Copy this file to .env and adjust for your provider.
#
# Supported PROVIDER values:
#   - gemini             : Google Gemini API (BASE_URL defaults to Google endpoints)
#   - openai_compatible : OpenAI or any compatible endpoint (vLLM, Ollama, OpenRouter, etc.)
#   - anthropic         : Anthropic Messages API
#   - custom            : Explicit endpoint URL with API_FORMAT=gemini|openai|anthropic
# ==============================================================================

# Provider selection
PROVIDER=gemini

# Base URL (for gemini, openai_compatible, or anthropic, provide the host or full base path)
BASE_URL=https://generativelanguage.googleapis.com

# API Key (or provide via environment variable: ZAGENT_API_KEY)
API_KEY=your_api_key_here

# Model identifier
MODEL=gemini-2.5-pro

# Format only required if PROVIDER=custom (options: gemini, openai, anthropic)
# API_FORMAT=gemini

# ==============================================================================
# Context Window & Compaction Controls
# ==============================================================================
# Total token window for the selected model
CONTEXT_LIMIT=1000000

# When to automatically trigger context compaction (exact tokens or a percentage)
COMPACT_AT=80%

# ==============================================================================
# Multimodal Capabilities
# ==============================================================================
# Toggle true ONLY for capabilities natively supported by your selected model.
# Unsupported attachments are rejected with a helpful model-readable explanation.
VISION=true
AUDIO=false
PDF=true
VIDEO=false
